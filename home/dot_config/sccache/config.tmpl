# Local compiler cache shared by shell, Cargo, and GUI/non-login builds.
# 250 GiB is a limit, not an allocation. Use SCCACHE_CACHE_SIZE per machine.
# Client-side mode was slower in the recorded local 0.17.0 probes.
client_side_mode = false

[cache.disk]
dir = {{ printf "%s/.cache/sccache" .chezmoi.homeDir | quote }}
size = 268435456000

[cache.disk.preprocessor_cache_mode]
use_preprocessor_cache_mode = true
file_stat_matches = false
use_ctime_for_stat = true
ignore_time_macros = false
skip_system_headers = false
hash_working_directory = true
