#!/usr/bin/env bash

set -euo pipefail

PROGRAM="git wt"

die() {
    printf '%s: %s\n' "$PROGRAM" "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
git wt - branch-aware Git worktrees

Usage:
  git wt new <name> [<start-point>]
  git wt add <branch>
  git wt init [--path <path>] [--add <branch>]...
  git wt <list|lock|move|prune|remove|repair|unlock> [<args>...]
  git wt help

Commands:
  new       Create a personal branch and matching nested worktree.
  add       Add an existing local branch at its matching nested path.
  init      Convert a normal clone into a .bare + worktrees layout.
  list      List worktrees using Git's native command.
  help      Show this help.

Shell command:
  gwtize    Run 'git wt init' and enter the primary worktree.

Native worktree commands are passed through unchanged:
  lock, move, prune, remove, repair, unlock

Examples:
  git wt init
  git wt new perf/fft develop
  git wt add main
  git wt list

Branch namespaces are selected from the push remote's host:
  [gwt "github.com"]
      user = cadebrown

If a host has no mapping, 'new' stops and prints the git-config command needed
to add one. Run 'git wt help <new|add|init>' for policy-command help.
EOF
}

usage_new() {
    cat <<'EOF'
Usage: git wt new <name> [<start-point>]

Create a new personal branch and worktree. The configured forge username is
prepended unless <name> already starts with it. The worktree path mirrors the
full branch name.

Example on an NVIDIA remote:
  git wt new perf/fft develop

creates branch 'cadeb/perf/fft' at '<layout>/cadeb/perf/fft'.
EOF
}

usage_add() {
    cat <<'EOF'
Usage: git wt add <branch>

Add an existing local branch without changing its name. The worktree path
mirrors the complete branch name. Git refuses a branch that is already checked
out in another worktree.

Examples:
  git wt add main
  git wt add cadeb/perf/fft
EOF
}

usage_init() {
    cat <<'EOF'
Usage: git wt init [--path <path>] [--add <branch>]...

Convert the normal repository at the current directory into a self-contained
layout with '.bare' as the common Git directory and one or more worktrees.
The default primary path mirrors the current branch.

Options:
  --path <path>    Override the primary worktree path.
  --add <branch>   Add an existing local branch after conversion. Repeatable.
  -h, --help       Show this help.

For compatibility, positional arguments use the old gwtize form:
  git wt init [<primary-path>] [<extra-branch>...]

The conversion preserves staged, unstaged, and untracked files. It refuses
repositories with active Git operations, sparse checkout, initialized
submodules, split index, existing linked worktrees, or a conflicting primary
path.
EOF
}

require_worktree() {
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
        || die "not inside a Git worktree"
}

absolute_common_dir() {
    local common
    if common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
        printf '%s\n' "$common"
        return
    fi

    common="$(git rev-parse --git-common-dir 2>/dev/null)" \
        || die "cannot resolve the common Git directory"
    if [[ "$common" == /* ]]; then
        printf '%s\n' "$common"
    else
        (cd "$common" && pwd -P)
    fi
}

layout_root() {
    local common root
    require_worktree
    common="$(absolute_common_dir)"
    [[ "${common##*/}" == ".bare" ]] \
        || die "this repository is not gwtized; run 'git wt init' from its normal clone"
    [[ "$(git --git-dir="$common" rev-parse --is-bare-repository 2>/dev/null)" == "true" ]] \
        || die "the common Git directory is not bare: $common"
    root="$(dirname "$common")"
    (cd "$root" && pwd -P)
}

current_push_remote() {
    local branch remote remotes
    branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
    remote=""

    if [[ -n "$branch" ]]; then
        remote="$(git config --get "branch.$branch.pushRemote" 2>/dev/null || true)"
    fi
    [[ -n "$remote" ]] \
        || remote="$(git config --get remote.pushDefault 2>/dev/null || true)"
    if [[ -z "$remote" && -n "$branch" ]]; then
        remote="$(git config --get "branch.$branch.remote" 2>/dev/null || true)"
    fi
    [[ "$remote" != "." ]] || remote=""

    if [[ -z "$remote" ]] && git remote get-url origin >/dev/null 2>&1; then
        remote="origin"
    fi
    if [[ -z "$remote" ]]; then
        remotes="$(git remote)"
        if [[ -n "$remotes" && "$remotes" != *$'\n'* ]]; then
            remote="$remotes"
        fi
    fi

    [[ -n "$remote" ]] || die "cannot select a push remote"
    printf '%s\n' "$remote"
}

fallback_url_host() {
    local url="$1" authority host
    case "$url" in
        *://*)
            authority="${url#*://}"
            authority="${authority%%/*}"
            authority="${authority##*@}"
            host="${authority%%:*}"
            ;;
        *@*:*)
            host="${url#*@}"
            host="${host%%:*}"
            ;;
        *)
            return 1
            ;;
    esac
    [[ -n "$host" ]] || return 1
    printf '%s\n' "$host"
}

push_remote_host() {
    local remote url host
    remote="$(current_push_remote)"
    url="$(git remote get-url --push "$remote" 2>/dev/null)" \
        || die "cannot read the push URL for remote '$remote'"

    host="$(git url-parse -c host "$url" 2>/dev/null || true)"
    [[ -n "$host" ]] || host="$(fallback_url_host "$url" || true)"
    [[ -n "$host" ]] || die "cannot determine a host from remote URL '$url'"
    printf '%s\n' "$host"
}

personal_namespace() {
    local host user
    host="$(push_remote_host)"
    user="$(git config --get "gwt.$host.user" 2>/dev/null || true)"
    if [[ -z "$user" ]]; then
        die "no branch namespace configured for $host; run: git config --global gwt.$host.user <username>"
    fi
    git check-ref-format --branch "$user/probe" >/dev/null 2>&1 \
        || die "invalid branch namespace '$user' configured for $host"
    printf '%s\n' "$user"
}

validate_branch() {
    local branch="$1"
    git check-ref-format --branch "$branch" >/dev/null 2>&1 \
        || die "invalid branch name '$branch'"
}

validate_relative_path() {
    local path="$1"
    [[ -n "$path" ]] || die "worktree path cannot be empty"
    [[ "$path" != /* ]] || die "worktree path must be relative: $path"
    git check-ref-format --branch "$path" >/dev/null 2>&1 \
        || die "unsafe worktree path '$path'"
}

ensure_destination_absent() {
    local path="$1"
    [[ ! -e "$path" && ! -L "$path" ]] \
        || die "worktree destination already exists: $path"
}

paths_overlap() {
    local left="$1" right="$2"
    [[ "$left" == "$right" || "$left" == "$right/"* || "$right" == "$left/"* ]]
}

ensure_layout_destination() {
    local root="$1" relative="$2" destination current worktree line component
    local -a components=()
    local index

    destination="$root/$relative"
    current="$root"
    IFS='/' read -r -a components <<< "$relative"
    for (( index=0; index<${#components[@]}-1; index++ )); do
        component="${components[$index]}"
        current="$current/$component"
        [[ ! -L "$current" ]] \
            || die "worktree path crosses a symlink: $current"
        [[ ! -e "$current" || -d "$current" ]] \
            || die "worktree path crosses a non-directory: $current"
    done
    ensure_destination_absent "$destination"

    while IFS= read -r line; do
        [[ "$line" == "worktree "* ]] || continue
        worktree="${line#worktree }"
        if [[ "$destination" == "$worktree" || "$destination" == "$worktree/"* ]]; then
            die "worktree destination is inside an existing worktree: $worktree"
        fi
    done < <(git worktree list --porcelain)
}

cmd_new() {
    local name="${1:-}" start_point="${2:-HEAD}" namespace branch root destination
    [[ "$name" != "-h" && "$name" != "--help" ]] || { usage_new; return; }
    [[ -n "$name" ]] || { usage_new >&2; exit 2; }
    [[ $# -le 2 ]] || { usage_new >&2; exit 2; }

    root="$(layout_root)"
    namespace="$(personal_namespace)"
    if [[ "$name" == "$namespace/"* ]]; then
        branch="$name"
    else
        branch="$namespace/$name"
    fi
    validate_branch "$branch"
    git show-ref --verify --quiet "refs/heads/$branch" \
        && die "branch already exists: $branch; use 'git wt add $branch'"

    destination="$root/$branch"
    ensure_layout_destination "$root" "$branch"
    git worktree add -b "$branch" "$destination" "$start_point" >&2
    printf '%s\n' "$destination"
}

cmd_add() {
    local branch="${1:-}" root destination
    [[ "$branch" != "-h" && "$branch" != "--help" ]] || { usage_add; return; }
    [[ -n "$branch" && $# -eq 1 ]] || { usage_add >&2; exit 2; }
    validate_branch "$branch"
    git show-ref --verify --quiet "refs/heads/$branch" \
        || die "local branch does not exist: $branch; use 'git wt new' to create a personal branch"

    root="$(layout_root)"
    destination="$root/$branch"
    ensure_layout_destination "$root" "$branch"
    git worktree add "$destination" "$branch" >&2
    printf '%s\n' "$destination"
}

active_operation() {
    local marker path
    for marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG; do
        path="$(git rev-parse --git-path "$marker")"
        [[ ! -e "$path" ]] || return 0
    done
    for marker in rebase-apply rebase-merge sequencer; do
        path="$(git rev-parse --git-path "$marker")"
        [[ ! -d "$path" ]] || return 0
    done
    return 1
}

init_rollback() {
    local item parent rollback_incomplete=0
    local -a remaining_items=()
    set +e
    INIT_ACTIVE=0

    if [[ -n "${INIT_DESTINATION:-}" && -d "$INIT_DESTINATION" ]]; then
        for item in "${INIT_MOVED_ITEMS[@]+"${INIT_MOVED_ITEMS[@]}"}"; do
            if [[ -e "$INIT_DESTINATION/$item" || -L "$INIT_DESTINATION/$item" ]]; then
                if [[ -e "$INIT_ROOT/$item" || -L "$INIT_ROOT/$item" ]] \
                    || ! mv -- "$INIT_DESTINATION/$item" "$INIT_ROOT/"; then
                    rollback_incomplete=1
                fi
            fi
        done
        shopt -s dotglob nullglob
        remaining_items=("$INIT_DESTINATION"/*)
        shopt -u dotglob nullglob
        for item in "${remaining_items[@]+"${remaining_items[@]}"}"; do
            [[ "${item##*/}" == ".git" ]] || rollback_incomplete=1
        done
    fi

    if (( ! rollback_incomplete && ${INIT_WORKTREE_CREATED:-0} )) \
        && [[ -n "${INIT_COMMON:-}" && -d "$INIT_COMMON" && -n "${INIT_DESTINATION:-}" ]]; then
        git --git-dir="$INIT_COMMON" worktree remove --force "$INIT_DESTINATION" >/dev/null 2>&1 \
            || rollback_incomplete=1
    fi

    if (( ! rollback_incomplete )) && [[ -n "${INIT_DESTINATION:-}" ]]; then
        parent="$(dirname "$INIT_DESTINATION")"
        while [[ "$parent" != "$INIT_ROOT" && "$parent" == "$INIT_ROOT/"* ]]; do
            rmdir "$parent" 2>/dev/null || break
            parent="$(dirname "$parent")"
        done
    fi

    if (( ! rollback_incomplete )) \
        && [[ -n "${INIT_COMMON:-}" && -d "$INIT_COMMON" && ! -e "$INIT_ROOT/.git" ]]; then
        if [[ -n "${INIT_CONFIG_BACKUP:-}" && -f "$INIT_CONFIG_BACKUP" ]] \
            && ! cp "$INIT_CONFIG_BACKUP" "$INIT_COMMON/config"; then
            rollback_incomplete=1
        elif ! mv -- "$INIT_COMMON" "$INIT_ROOT/.git"; then
            rollback_incomplete=1
        fi
    fi

    if (( rollback_incomplete )); then
        printf '%s: rollback incomplete; no remaining worktree data was deleted\n' "$PROGRAM" >&2
        printf '%s: recover repository metadata at %s\n' "$PROGRAM" "$INIT_COMMON" >&2
        printf '%s: recover worktree content between %s and %s\n' \
            "$PROGRAM" "$INIT_ROOT" "$INIT_DESTINATION" >&2
        [[ -z "${INIT_CONFIG_BACKUP:-}" ]] \
            || printf '%s: original config backup: %s\n' "$PROGRAM" "$INIT_CONFIG_BACKUP" >&2
        [[ -z "${INIT_INDEX_BACKUP:-}" ]] \
            || printf '%s: original index backup: %s\n' "$PROGRAM" "$INIT_INDEX_BACKUP" >&2
        return 1
    fi

    [[ -z "${INIT_CONFIG_BACKUP:-}" ]] || rm -f "$INIT_CONFIG_BACKUP"
    [[ -z "${INIT_INDEX_BACKUP:-}" ]] || rm -f "$INIT_INDEX_BACKUP"
}

init_exit() {
    local exit_status="$1"
    if [[ ${INIT_ACTIVE:-0} -eq 1 ]]; then
        init_rollback
    fi
    exit "$exit_status"
}

cmd_init() {
    local primary_path="" print_path=0 branch="" detached=0 commit target top item
    local config_backup index_backup index_path worktree_count submodule_status
    local shared_index_path
    local -a extra_branches=() checked_extra_paths=()
    local checked_path

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --path)
                [[ $# -ge 2 ]] || die "--path requires a value"
                primary_path="$2"
                shift 2
                ;;
            --add)
                [[ $# -ge 2 ]] || die "--add requires a branch"
                extra_branches+=("$2")
                shift 2
                ;;
            --print-path)
                print_path=1
                shift
                ;;
            -h|--help)
                usage_init
                return
                ;;
            --)
                shift
                while [[ $# -gt 0 ]]; do
                    if [[ -z "$primary_path" ]]; then
                        primary_path="$1"
                    else
                        extra_branches+=("$1")
                    fi
                    shift
                done
                ;;
            -*)
                die "unknown init option '$1'"
                ;;
            *)
                if [[ -z "$primary_path" ]]; then
                    primary_path="$1"
                else
                    extra_branches+=("$1")
                fi
                shift
                ;;
        esac
    done

    [[ -d .git ]] || {
        [[ -f .git ]] && die "already inside a linked worktree"
        die "run 'git wt init' from the root of a normal clone"
    }
    INIT_ROOT="$(pwd -P)"
    [[ "$(git rev-parse --show-toplevel 2>/dev/null)" == "$INIT_ROOT" ]] \
        || die "run 'git wt init' from the repository root"
    [[ "$(git rev-parse --is-bare-repository 2>/dev/null)" == "false" ]] \
        || die "repository is already bare"
    [[ ! -e .bare ]] || die "destination common directory already exists: $INIT_ROOT/.bare"
    [[ -f .git/index ]] || die "repository has no index; make an initial commit first"
    git rev-parse --verify HEAD >/dev/null 2>&1 \
        || die "repository has no commit; make an initial commit first"

    worktree_count="$(git worktree list --porcelain | grep -c '^worktree ' || true)"
    [[ "$worktree_count" -eq 1 ]] \
        || die "repository already has linked worktrees; remove them before conversion"
    active_operation && die "finish or abort the active Git operation before conversion"
    [[ "$(git config --bool core.sparseCheckout 2>/dev/null || true)" != "true" ]] \
        || die "disable sparse checkout before conversion"
    shared_index_path="$(git rev-parse --shared-index-path 2>/dev/null || true)"
    [[ -z "$shared_index_path" ]] \
        || die "disable split index with 'git update-index --no-split-index' before conversion"
    if ! submodule_status="$(git submodule status --recursive 2>/dev/null)"; then
        die "cannot inspect submodule state"
    fi
    if printf '%s\n' "$submodule_status" | grep -q '^[ +U]'; then
        die "deinitialize submodules before conversion"
    fi

    if branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null)"; then
        target="$branch"
    else
        detached=1
        commit="$(git rev-parse --short HEAD)"
        target="$(git rev-parse HEAD)"
        [[ -n "$primary_path" ]] || primary_path="detached-$commit"
    fi
    [[ -n "$primary_path" ]] || primary_path="$branch"
    validate_relative_path "$primary_path"
    top="${primary_path%%/*}"
    [[ ! -e "$INIT_ROOT/$top" && ! -L "$INIT_ROOT/$top" ]] \
        || die "primary path conflicts with repository content: $top; use --path to choose another"

    for branch in "${extra_branches[@]+"${extra_branches[@]}"}"; do
        validate_branch "$branch"
        git show-ref --verify --quiet "refs/heads/$branch" \
            || die "extra local branch does not exist: $branch"
        (( detached )) || [[ "$branch" != "$target" ]] \
            || die "extra branch is already the primary worktree: $branch"
        paths_overlap "$primary_path" "$branch" \
            && die "primary and extra worktree paths overlap: $primary_path and $branch"
        for checked_path in "${checked_extra_paths[@]+"${checked_extra_paths[@]}"}"; do
            paths_overlap "$checked_path" "$branch" \
                && die "extra worktree paths overlap: $checked_path and $branch"
        done
        checked_extra_paths+=("$branch")
    done

    config_backup="$(mktemp "${TMPDIR:-/tmp}/git-wt-config.XXXXXX")"
    index_backup="$(mktemp "${TMPDIR:-/tmp}/git-wt-index.XXXXXX")"
    cp .git/config "$config_backup"
    cp .git/index "$index_backup"

    INIT_COMMON="$INIT_ROOT/.bare"
    INIT_DESTINATION="$INIT_ROOT/$primary_path"
    INIT_CONFIG_BACKUP="$config_backup"
    INIT_INDEX_BACKUP="$index_backup"
    INIT_MOVED_ITEMS=()
    INIT_ACTIVE=1
    INIT_WORKTREE_CREATED=0
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'init_exit $?' EXIT

    mv -- .git .bare
    if ! git --git-dir="$INIT_COMMON" config core.bare true; then
        init_rollback
        die "failed to configure the bare repository"
    fi
    git --git-dir="$INIT_COMMON" config --unset-all core.worktree 2>/dev/null || true

    if (( detached )); then
        if ! git --git-dir="$INIT_COMMON" worktree add --no-checkout --detach \
            "$INIT_DESTINATION" "$target" >&2; then
            git --git-dir="$INIT_COMMON" worktree list --porcelain \
                | grep -Fqx "worktree $INIT_DESTINATION" \
                && INIT_WORKTREE_CREATED=1
            init_rollback
            die "failed to create the primary detached worktree"
        fi
    elif ! git --git-dir="$INIT_COMMON" worktree add --no-checkout \
        "$INIT_DESTINATION" "$target" >&2; then
        git --git-dir="$INIT_COMMON" worktree list --porcelain \
            | grep -Fqx "worktree $INIT_DESTINATION" \
            && INIT_WORKTREE_CREATED=1
        init_rollback
        die "failed to create the primary worktree"
    fi
    INIT_WORKTREE_CREATED=1

    index_path="$(git -C "$INIT_DESTINATION" rev-parse --git-path index 2>/dev/null || true)"
    if [[ -z "$index_path" ]] || ! cp "$index_backup" "$index_path"; then
        init_rollback
        die "failed to restore the primary worktree index"
    fi

    shopt -s dotglob nullglob
    for item in "$INIT_ROOT"/*; do
        [[ "$item" == "$INIT_COMMON" || "$item" == "$INIT_ROOT/$top" ]] && continue
        if ! mv -- "$item" "$INIT_DESTINATION/"; then
            init_rollback
            die "failed while moving '${item##*/}' into the primary worktree"
        fi
        INIT_MOVED_ITEMS+=("${item##*/}")
    done
    shopt -u dotglob nullglob

    rm -f "$config_backup" "$index_backup"
    INIT_CONFIG_BACKUP=""
    INIT_INDEX_BACKUP=""
    INIT_ACTIVE=0
    trap - EXIT INT TERM

    for branch in "${extra_branches[@]+"${extra_branches[@]}"}"; do
        if ! git --git-dir="$INIT_COMMON" worktree add "$INIT_ROOT/$branch" "$branch" >&2; then
            printf '%s: warning: failed to add worktree for %s\n' "$PROGRAM" "$branch" >&2
        fi
    done

    if (( ! print_path )); then
        printf '%s: converted repository to .bare + worktrees layout\n' "$PROGRAM" >&2
        git --git-dir="$INIT_COMMON" worktree list >&2
    fi
    printf '%s\n' "$INIT_DESTINATION"
}

command_name="${1:-help}"
[[ $# -eq 0 ]] || shift

case "$command_name" in
    -h|--help|help)
        case "${1:-}" in
            "") usage ;;
            new) usage_new ;;
            add) usage_add ;;
            init) usage_init ;;
            *) die "unknown help topic '$1'" ;;
        esac
        ;;
    new)
        cmd_new "$@"
        ;;
    add)
        cmd_add "$@"
        ;;
    init)
        cmd_init "$@"
        ;;
    list|lock|move|prune|remove|repair|unlock)
        exec git worktree "$command_name" "$@"
        ;;
    *)
        die "unknown command '$command_name'; run 'git wt help'"
        ;;
esac
