#!/usr/bin/env bash
set -euo pipefail
_repo="${DF_DOTFILES_REPO:-$HOME/dotfiles}"
# shellcheck source=install/agent-runtime.sh
source "$_repo/install/agent-runtime.sh" --runtime-only >&2
export PATH="$ARCH_BIN:$HOME/.local/bin:$PATH"
export UV_CACHE_DIR="${UV_CACHE_DIR:-$LOCAL_PLAT/uv/cache}"
# A GUI-launched shell may predate auth setup. Explicit environment keys win.
if [[ -z "${GOOGLE_API_KEY:-}${GEMINI_API_KEY:-}" && -r "$HOME/.gemini.env" ]]; then
    # shellcheck source=/dev/null
    source "$HOME/.gemini.env"
fi
_uv="$(command -v uv || true)"
[[ -n "$_uv" ]] || { printf '%s\n' "Run install/python.sh before using df-gemini" >&2; exit 1; }
exec "$_uv" --quiet run --locked --script "$_repo/install/gemini-api.py" "$@"
