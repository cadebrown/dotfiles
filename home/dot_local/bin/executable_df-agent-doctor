#!/usr/bin/env bash
# Fast end-to-end healthcheck for the local coding-agent harness.

if [[ "$(uname -s)" == "Darwin" ]] \
    && (( BASH_VERSINFO[0] > 5 || (BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] >= 3) )) \
    && [[ "$BASH" != "/bin/bash" ]]; then
    exec /bin/bash "$0" "$@"
fi

set -uo pipefail

_repo="${DF_DOTFILES_REPO:-$HOME/dotfiles}"
_fail=0

_check() {
    local _name="$1"
    shift
    if "$@" >/dev/null 2>&1; then
        printf '[okay] %s\n' "$_name"
    else
        printf '[fail] %s\n' "$_name"
        _fail=1
    fi
}

_has() { command -v "$1" >/dev/null 2>&1; }
_cass_healthy() { cass health --robot | jq -e '.status == "healthy"' >/dev/null; }
_json_healthy() { [[ -f "$1" ]] && jq -e . "$1" >/dev/null; }
_mcp_registry_healthy() (
    source "$_repo/install/_lib.sh"
    mcp_registry_validate
)
_node_path_healthy() (
    source "$_repo/install/_lib.sh"
    local _want _actual
    _want="$(resolve_nvm_default_bin)" || return 1
    _actual="$(command -v node)" || return 1
    [[ "${_actual%/*}" == "$_want" ]]
)

for _tool in jq yq chezmoi codex claude opencode pi qmd cass rtk; do
    _check "tool: $_tool" _has "$_tool"
done
if [[ "$(uname -s)" == "Darwin" ]]; then
    _check "tool: cursor" _has cursor
fi

if _has cass && _has jq; then
    _check "cass hybrid index" _cass_healthy
fi
if _has qmd; then
    _check "qmd index" qmd status
fi
if _has jq; then
    _check "MCP registry" _mcp_registry_healthy
    _check "Claude settings" _json_healthy "$HOME/.claude/settings.json"
    _check "Claude MCP state" _json_healthy "$HOME/.claude.json"
    _check "Codex hooks" _json_healthy "$HOME/.codex/hooks.json"
    _check "OpenCode config" _json_healthy "$HOME/.config/opencode/opencode.json"
    _check "Pi settings" _json_healthy "$HOME/.pi/agent/settings.json"
    _check "Pi models" _json_healthy "$HOME/.pi/agent/models.json"
    if [[ "$(uname -s)" == "Darwin" ]]; then
        _check "Cursor hooks" _json_healthy "$HOME/.cursor/hooks.json"
        _check "Cursor MCP" _json_healthy "$HOME/.cursor/mcp.json"
    fi
fi
if _has node; then
    _check "Node default PATH" _node_path_healthy
fi
if [[ -f "$_repo/install/skills-sync.sh" ]]; then
    _check "skill registry" bash "$_repo/install/skills-sync.sh" check
fi
if [[ -x "$_repo/install/codex.sh" ]] && _has codex; then
    _check "Codex config and plugins" bash "$_repo/install/codex.sh" check
fi
if [[ -x "$_repo/install/opencode.sh" ]] && _has opencode; then
    _check "OpenCode generated config" bash "$_repo/install/opencode.sh" check
fi
if [[ "$(uname -s)" == "Darwin" ]]; then
    _check "qmd LaunchAgent" launchctl print "gui/$(id -u)/dev.cade.qmd"
    _check "cass lexical LaunchAgent" launchctl print "gui/$(id -u)/dev.cade.cass-watch"
    _check "cass semantic LaunchAgent" launchctl print "gui/$(id -u)/dev.cade.cass-semantic"
fi

exit "$_fail"
