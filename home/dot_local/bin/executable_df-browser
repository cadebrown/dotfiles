#!/usr/bin/env -S uv run --no-project --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Project-bound Playwright sessions with private profiles and explicit attachment."""

import argparse
import contextlib
import datetime as dt
import fcntl
import hashlib
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import tempfile
from pathlib import Path
from urllib.parse import urlsplit


def fail(message):
    raise ValueError(message)


def digest(value):
    return hashlib.sha256(str(value).encode()).hexdigest()[:16]


def timestamp():
    return dt.datetime.now(dt.UTC).isoformat()


def host_identity():
    if os.environ.get("DF_BROWSER_HOST_ID"):
        return os.environ["DF_BROWSER_HOST_ID"]
    if sys.platform.startswith("linux"):
        for path in (Path("/etc/machine-id"), Path("/var/lib/dbus/machine-id")):
            if path.is_file() and path.read_text().strip():
                return path.read_text().strip()
    if sys.platform == "darwin":
        result = subprocess.run(["/usr/sbin/ioreg", "-rd1", "-c", "IOPlatformExpertDevice"],
                                capture_output=True, text=True, timeout=10, check=False)
        match = re.search(r'"IOPlatformUUID"\s*=\s*"([^"\n]+)"', result.stdout)
        if match:
            return match.group(1)
    return socket.gethostname()


def name(value):
    if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,47}", value):
        fail("Names must contain 1–48 lowercase letters, digits, underscores or hyphens")
    return value


def private_dir(path):
    if path.is_symlink():
        fail(f"Refusing symlink directory: {path}")
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    if path.stat().st_uid != os.getuid():
        fail(f"Directory is not owned by this user: {path}")
    path.chmod(0o700)


def write_json(path, data):
    if path.is_symlink():
        fail(f"Refusing symlink file: {path}")
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as stream:
        json.dump(data, stream, indent=2)
        stream.write("\n")
        temporary = Path(stream.name)
    temporary.chmod(0o600)
    temporary.replace(path)


def emit(data):
    print(json.dumps(data, indent=2))


def project_path(explicit):
    if explicit:
        project = Path(explicit).expanduser().resolve(strict=True)
    else:
        result = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=False)
        project = Path(result.stdout.strip()).resolve() if result.returncode == 0 else Path.cwd().resolve()
    if not project.is_dir():
        fail("Project must be a directory")
    return project


class Workspace:
    def __init__(self, root, project, service):
        self.project = project
        self.service = service
        self.path = root / digest(project) / service
        self.session = "df-" + digest(str(root) + "/" + str(project) + "/" + service)
        self.metadata = self.path / "workspace.json"
        self.profile = self.path / "profile"
        self.artifacts = self.path / "artifacts"
        self.config = self.path / "playwright.json"
        self.data = None

    @contextlib.contextmanager
    def locked(self, create=False):
        if not self.path.exists() and not create:
            fail(f"Unknown workspace {self.service!r}; use open or attach first")
        private_dir(self.path.parent)
        private_dir(self.path)
        lock = self.path / ".lock"
        if lock.is_symlink():
            fail("Refusing symlink workspace lock")
        with lock.open("a") as stream:
            fcntl.flock(stream, fcntl.LOCK_EX)
            if self.metadata.exists():
                if self.metadata.is_symlink():
                    fail("Refusing symlink workspace metadata")
                self.data = json.loads(self.metadata.read_text())
                expected = {"version": 1, "project": str(self.project), "service": self.service, "session": self.session}
                if any(self.data.get(key) != value for key, value in expected.items()):
                    fail("Workspace ownership metadata does not match this project/service")
                if self.data.get("mode") not in ("owned", "extension"):
                    fail("Unknown workspace ownership mode")
            elif not create:
                fail("Workspace ownership metadata is missing")
            yield

    def initialize(self, mode, browser):
        if self.data:
            if self.data["mode"] != mode:
                fail("Workspace mode cannot change; choose a different service name")
            if browser and self.data["browser"] != browser:
                fail("Workspace browser cannot change; choose a different service name")
        else:
            self.data = {"version": 1, "project": str(self.project), "service": self.service,
                         "session": self.session, "mode": mode, "browser": browser or "chrome",
                         "created_at": timestamp()}
        private_dir(self.artifacts)
        private_dir(self.path / ".playwright")
        write_json(self.config, {"outputDir": str(self.artifacts)})
        self.save()

    def save(self):
        write_json(self.metadata, self.data)

    def cli(self, *arguments, quiet=False):
        executable = shutil.which("playwright-cli")
        if not executable:
            fail("playwright-cli is missing; run the dotfiles npm installer")
        environment = dict(os.environ, NO_UPDATE_NOTIFIER="1", NO_COLOR="1", CLICOLOR="0")
        # A caller's MCP attachment/profile variables must not redirect this owned session.
        for key in list(environment):
            if key.startswith("PLAYWRIGHT_MCP_") or key in ("PLAYWRIGHT_CLI_SESSION", "CLICOLOR_FORCE", "FORCE_COLOR"):
                environment.pop(key)
        result = subprocess.run([executable, "-s=" + self.session, *arguments, "--json"],
                                cwd=self.path, env=environment, capture_output=True, text=True, timeout=120, check=False)
        try:
            response = json.loads(result.stdout)
        except json.JSONDecodeError:
            response = None
        if result.returncode or response is None or response.get("isError") or response.get("error"):
            detail = "Run playwright-cli --version and check the workspace/browser is available"
            if not quiet:
                detail = (result.stdout + result.stderr).strip() or detail
            fail(f"Playwright {arguments[0]} failed: {detail}")
        return response

    def running(self):
        browsers = self.cli("list").get("browsers", [])
        session = next((item for item in browsers if item.get("name") == self.session and item.get("status") == "open"), None)
        if session:
            if bool(session.get("attached")) != (self.data["mode"] == "extension"):
                fail("Running session ownership differs from workspace metadata")
            if self.data["mode"] == "owned" and Path(session.get("userDataDir", "")).resolve() != self.profile.resolve():
                fail("Running session uses a different profile; refusing to control it")
        return session

    def require_running(self):
        if not self.running():
            fail("Workspace is closed; use open or attach first")

    def prepare_owned_close(self):
        # CLI 0.1.19 reenters shutdown from this listener and kills Chrome before cookie flush.
        self.cli("run-code", """async page => {
          const context = page.context();
          const prepared = Symbol.for('df-browser.graceful-close');
          if (context[prepared]) return {prepared: true};
          const listeners = context.listeners('close').filter(callback => {
            const source = callback.toString();
            return source.includes('deleteSessionFile') && source.includes('gracefullyProcessExitDoNotHang');
          });
          if (listeners.length !== 1)
            throw new Error('Unsupported Playwright CLI shutdown handler; leave the profile open and update df-browser');
          context.removeListener('close', listeners[0]);
          context[prepared] = true;
          return {prepared: true};
        }""")

    def status(self):
        running = self.running()
        return {"service": self.service, "project": str(self.project), "mode": self.data["mode"],
                "session": self.session, "running": bool(running), "browser": self.data["browser"],
                "headed": running.get("headed") if running else None,
                "profile": str(self.profile) if self.data["mode"] == "owned" else None,
                "artifacts": str(self.artifacts), "auth": self.data.get("auth", {"status": "unknown"})}


def validate_url(url):
    parsed = urlsplit(url)
    if url != "about:blank" and (parsed.scheme not in ("http", "https") or not parsed.hostname):
        fail("Use an HTTP(S) URL or about:blank")
    if parsed.username or parsed.password:
        fail("URLs containing credentials are not supported")
    return url


def auth_check(workspace, selector):
    selector = selector or workspace.data.get("signed_in_selector")
    code = """async page => {
      const selector = SELECTOR;
      const signedIn = selector ? await page.locator(selector).first().isVisible() : null;
      const loginForm = await page.locator('input[type="password"]').first().isVisible();
      const cookies = await page.context().cookies();
      const expiries = cookies.map(c => c.expires).filter(expiry => expiry > 0);
      return {signed_in_marker: signedIn, password_form: loginForm,
        origin: await page.evaluate(() => location.origin), cookie_count: cookies.length,
        earliest_cookie_expiry: expiries.length ? Math.min(...expiries) : null};
    }""".replace("SELECTOR", json.dumps(selector))
    response = workspace.cli("run-code", code, quiet=True)
    result = response.get("result")
    observation = json.loads(result) if isinstance(result, str) else result
    if not isinstance(observation, dict) or "cookie_count" not in observation:
        fail("Unexpected authentication observation from Playwright")
    if observation["signed_in_marker"]:
        status, reason = "signed-in", "configured signed-in marker is visible"
    elif observation["signed_in_marker"] is False:
        status, reason = "needs-login", "signed-in marker is absent; confirm the page has finished loading"
    elif observation["password_form"]:
        status, reason = "needs-login", "password form is visible"
    else:
        status, reason = "unknown", "no signed-in marker configured and no password form observed"
    expiry = observation["earliest_cookie_expiry"]
    observation["earliest_cookie_expiry"] = dt.datetime.fromtimestamp(expiry, dt.UTC).isoformat() if expiry else None
    observation.update(status=status, reason=reason, observed_at=timestamp(),
                       expiry_note="Cookie expiry is metadata, not proof of server-side session validity")
    if selector:
        workspace.data["signed_in_selector"] = selector
    workspace.data["auth"] = observation
    workspace.save()
    return observation


def validate_storage(path):
    if path.is_symlink() or not path.is_file():
        fail("Auth state must be a regular file, not a symlink")
    stat = path.stat()
    if stat.st_uid != os.getuid() or stat.st_mode & 0o077:
        fail("Auth state must be owned by you and private; chmod 600 the file first")
    state = json.loads(path.read_text())
    if not isinstance(state, dict) or not isinstance(state.get("cookies"), list) or not isinstance(state.get("origins"), list):
        fail("Expected a Playwright storage-state JSON object")
    return state


def parser():
    result = argparse.ArgumentParser(description=__doc__)
    result.add_argument("--project", help="Project directory (default: git root or current directory)")
    commands = result.add_subparsers(dest="command", required=True)
    for command in ("open", "attach", "status", "close", "remove", "check", "screenshot", "trace", "export-auth", "import-auth", "run", "view"):
        item = commands.add_parser(command)
        item.add_argument("service", type=name)
        if command == "open":
            item.add_argument("url", nargs="?", type=validate_url)
            item.add_argument("--headed", action="store_true", help="Show the owned browser window")
            item.add_argument("--browser", choices=("chrome", "firefox", "webkit", "msedge"))
        elif command == "attach":
            item.add_argument("--extension", required=True, nargs="?", const="chrome", choices=("chrome", "chrome-beta", "chrome-canary", "chrome-dev", "msedge", "msedge-beta", "msedge-dev", "msedge-canary"))
        elif command == "check":
            item.add_argument("--selector", help="CSS selector visible only while signed in; remembered for later checks")
        elif command == "screenshot":
            item.add_argument("label", nargs="?", default="page", type=name)
        elif command == "trace":
            item.add_argument("action", choices=("start", "stop"))
        elif command == "export-auth":
            item.add_argument("label", nargs="?", default="saved", type=name)
        elif command == "import-auth":
            item.add_argument("file", type=Path)
        elif command == "run":
            item.add_argument("arguments", nargs=argparse.REMAINDER, help="Playwright action and arguments")
    commands.add_parser("list")
    return result


def execute(args, workspace):
    command = args.command
    if command in ("open", "attach"):
        workspace.initialize("owned" if command == "open" else "extension", args.browser if command == "open" else args.extension)
        active = workspace.running()
        if active:
            if command == "open" and args.headed and not active.get("headed"):
                fail("Already running; close and reopen --headed to change window mode")
            if command == "open" and args.url:
                workspace.cli("goto", args.url)
        elif command == "open":
            private_dir(workspace.profile)
            url = args.url or workspace.data.get("url", "about:blank")
            options = ["open", url, "--profile=" + str(workspace.profile), "--browser=" + workspace.data["browser"], "--config=" + str(workspace.config)]
            if args.headed:
                options.append("--headed")
            workspace.cli(*options)
        else:
            workspace.cli("attach", "--extension=" + args.extension, "--config=" + str(workspace.config), quiet=True)
        if command == "open" and args.url:
            workspace.data["url"] = args.url
            workspace.save()
        return workspace.status()
    if command == "status":
        return workspace.status()
    if command == "close":
        if workspace.running():
            if workspace.data.get("tracing"):
                workspace.cli("tracing-stop")
            if workspace.data["mode"] == "owned":
                workspace.prepare_owned_close()
            workspace.cli("detach" if workspace.data["mode"] == "extension" else "close")
        workspace.data["tracing"] = False
        workspace.save()
        return workspace.status()
    if command == "remove":
        if workspace.running():
            fail("Close this workspace before removing its private profile and artifacts")
        workspace.cli("delete-data")
        shutil.rmtree(workspace.path)
        return {"removed": workspace.service, "external_browser_untouched": True}
    workspace.require_running()
    if command == "check":
        return auth_check(workspace, args.selector)
    if command == "screenshot":
        folder = workspace.artifacts / "screenshots"
        private_dir(folder)
        path = folder / (args.label + ".png")
        if path.exists() or path.is_symlink():
            fail("Screenshot label already exists; choose a new label")
        workspace.cli("screenshot", "--filename=" + str(path))
        return {"screenshot": str(path)}
    if command == "trace":
        workspace.cli("tracing-" + args.action)
        workspace.data["tracing"] = args.action == "start"
        workspace.save()
        return {"tracing": workspace.data["tracing"], "directory": str(workspace.artifacts / "traces")}
    if command == "view":
        return workspace.cli("show")
    if command in ("export-auth", "import-auth"):
        if workspace.data["mode"] != "owned":
            fail("Auth transfer is only supported for owned profiles; attached account state stays in its browser")
        folder = workspace.path / "auth"
        private_dir(folder)
        if command == "export-auth":
            path = folder / (args.label + ".json")
            if path.exists() or path.is_symlink():
                fail("Auth export label already exists; choose a new label")
            workspace.cli("state-save", str(path), quiet=True)
            path.chmod(0o600)
            validate_storage(path)
            return {"auth_file": str(path), "mode": "0600"}
        source = args.file.expanduser().absolute()
        state = validate_storage(source)
        path = folder / "imported.json"
        write_json(path, state)
        workspace.cli("state-load", str(path), quiet=True)
        workspace.data["auth"] = {"status": "unknown", "reason": "state imported; reload the service and run check"}
        workspace.save()
        return {"imported": True, "next": "Navigate or reload, then check the signed-in marker"}
    if command == "run":
        arguments = args.arguments
        if arguments and arguments[0] == "--":
            arguments = arguments[1:]
        forbidden = {"open", "attach", "close", "detach", "close-all", "kill-all", "delete-data", "install", "install-browser", "list", "state-save", "state-load", "screenshot", "tracing-start", "tracing-stop", "show"}
        if not arguments or arguments[0].startswith("-") or arguments[0] in forbidden:
            fail("Use df-browser lifecycle, auth, screenshot, and trace commands for managed operations")
        if any(arg == "-s" or arg.startswith(("-s=", "--session", "--profile", "--config", "--extension", "--cdp", "--endpoint")) for arg in arguments[1:]):
            fail("Cannot override the managed session, profile, or attachment")
        return workspace.cli(*arguments)
    fail("Unknown command")


def main():
    os.umask(0o077)
    args = parser().parse_args()
    project = project_path(args.project)
    base = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))).expanduser()
    root = base / "df-browser" / digest(host_identity())
    private_dir(root)
    if args.command == "list":
        records = []
        for metadata in sorted((root / digest(project)).glob("*/workspace.json")):
            workspace = Workspace(root, project, name(metadata.parent.name))
            with workspace.locked():
                records.append(workspace.status())
        emit({"workspaces": records})
    else:
        workspace = Workspace(root, project, args.service)
        with workspace.locked(create=args.command in ("open", "attach")):
            emit(execute(args, workspace))


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, subprocess.TimeoutExpired) as error:
        print(f"df-browser: {error}", file=sys.stderr)
        sys.exit(1)
