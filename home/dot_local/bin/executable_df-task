#!/bin/sh
set -eu

# A noninteractive POSIX shell avoids Bash's extra SSH .bashrc startup. Hooks
# already inherit a resolved runtime; ordinary CLI calls still resolve policy.
if [ "${1:-}" = hook ]; then
    case "${PYTHON_ENV:-}" in
        /*)
            if [ -x "$PYTHON_ENV/bin/python" ]; then
                exec "$PYTHON_ENV/bin/python" "$HOME/.local/lib/dotfiles/df_task.py" "$@"
            fi
            ;;
    esac
fi

exec bash -c '
    set -euo pipefail
    _repo="${DF_DOTFILES_REPO:-$HOME/dotfiles}"
    source "$_repo/install/agent-runtime.sh" --runtime-only
    _python="$PYTHON_ENV/bin/python"
    [[ -x "$_python" ]] || { printf "df-task requires the managed Python runtime: %s\n" "$_python" >&2; exit 1; }
    exec "$_python" "$HOME/.local/lib/dotfiles/df_task.py" "$@"
' df-task "$@"
