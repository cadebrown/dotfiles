# Local overrides take precedence over private overlays and public defaults.
Include ~/.ssh/config.d/*

# Reset any Host/Match scope left by a local include before loading overlays.
Host *
    Include "{{ joinPath .chezmoi.sourceDir ".." "dotfiles-*/ssh/config" }}"

Host *
    # Multiplexing — socket on local disk (not NFS)
    ControlPath /tmp/ssh-%C
    ControlMaster auto
    ControlPersist 600

    # Key management
    IgnoreUnknown UseKeychain
    AddKeysToAgent yes
{{- if eq .chezmoi.os "darwin" }}
    UseKeychain yes
{{- end }}

    # Reliability
    ServerAliveInterval 60
    ServerAliveCountMax 3
    ConnectTimeout 10

    # Security
    StrictHostKeyChecking accept-new
    HashKnownHosts yes

    # Local or private policy can opt in before this conservative default.
    ForwardAgent no
