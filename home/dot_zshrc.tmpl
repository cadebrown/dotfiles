### COMPLETIONS ###

# Xan CSV tool
if command -v xan &>/dev/null; then
    function __xan { xan compgen "$1" "$2" "$3"; }
    complete -F __xan -o default xan
fi

# Zoxide
if command -v zoxide &>/dev/null; then
    eval "$(zoxide init zsh)"
fi

# fzf — use fd as the default finder (respects .gitignore, includes hidden files)
if command -v fzf &>/dev/null; then
    if command -v fd &>/dev/null; then
        export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
        export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
        export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
    fi
    export FZF_DEFAULT_OPTS="--height=40% --reverse --border --info=inline"
    eval "$(fzf --zsh)"
fi

# atuin — SQLite-backed shell history search on ctrl-r. MUST init after fzf,
# which also binds ^R — last writer wins. Up-arrow stays native
# (--disable-up-arrow). Sync is off until configured (atuin register/login);
# local search works regardless. Data dir: ~/.local/share/atuin (scratch-linked
# on NFS machines, so the SQLite db stays local).
# Guard on init succeeding, not just the binary existing: a prebuilt atuin the
# loader rejects (needs newer glibc than the host) degrades quietly to fzf's
# ^R instead of erroring on every shell. install/rust.sh smoke-tests and
# rebuilds such binaries on the next bootstrap run.
if command -v atuin >/dev/null 2>&1 \
    && _atuin_init="$(atuin init zsh --disable-up-arrow 2>/dev/null)"; then
    eval "$_atuin_init"
fi
unset _atuin_init
