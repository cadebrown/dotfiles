#!/usr/bin/env bash
# Cursor user hook: copy live ~/.config/cursor JSON into chezmoi source so UI edits are tracked.
# Triggered from ~/.cursor/hooks.json (sessionStart, sessionEnd, beforeSubmitPrompt).
#
# DF_CURSOR_HOOK_SYNC_EXTENSIONS=0  — skip install/cursor.sh sync-extensions
# Unchanged live/source hashes skip imports; extensions sync only at session end.
# Cache and advisory locks are per checkout/home under XDG_CACHE_HOME (or ~/.cache).

set -euo pipefail

# Cursor hook processes often inherit a minimal PATH (Dock / Launcher). Add
# fallback directories without overriding tools already selected by the caller.
_df_fallback_path() {
  case ":${PATH:-}:" in *:"$1":*) return 0 ;; esac
  [[ -d "$1" ]] || return 0
  PATH="${PATH:+$PATH:}$1"
}
_df_fallback_path "$HOME/.local/bin"
for _plat_bin in "$HOME/.local"/plat_*/bin; do
  [[ -e "$_plat_bin" ]] && _df_fallback_path "$_plat_bin"
done
unset _plat_bin
_df_fallback_path "/opt/homebrew/bin"
_df_fallback_path "/usr/local/bin"
export PATH

DF_ROOT="${DF_ROOT:-{{ .chezmoi.workingTree }}}"
export DF_ROOT

# Bootstrap installs Python in the managed runtime. PATH resolution also supports
# system Python on a minimal host; this helper has no third-party dependencies.
_python="$(command -v python3 || true)"
_helper="$(dirname "${BASH_SOURCE[0]}")/sync_dotfiles_cursor.py"
if [[ -n "$_python" && -f "$_helper" ]]; then
  exec "$_python" "$_helper" "$@"
fi
printf '%s\n' '[df-cursor-hook] Python 3 or sync helper missing; rerun bootstrap/chezmoi apply' >&2
if [[ "${1:-}" == "--before-submit" ]]; then
  printf '%s\n' '{"continue":true}'
else
  printf '%s\n' '{}'
fi
