{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/df-chezmoi-guard",
            "statusMessage": "Checking chezmoi-managed paths"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/df-rtk-rewrite",
            "timeout": 10,
            "statusMessage": "rtk rewrite"
          }
        ]
      }
    ],
    "SessionStart": [{"hooks": [{"type": "command", "command": "~/.local/bin/df-task hook", "timeout": 3}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "~/.local/bin/df-task hook", "timeout": 3}]}],
    "PreCompact": [{"hooks": [{"type": "command", "command": "~/.local/bin/df-task hook", "timeout": 3}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "~/.local/bin/df-task hook", "timeout": 3}]}],
    "Interrupt": [{"hooks": [{"type": "command", "command": "~/.local/bin/df-task hook", "timeout": 3}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "~/.local/bin/df-task hook", "timeout": 3}]}]
  }
}
