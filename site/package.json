{
  "name": "dotfiles-handbook",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test scripts/verify.test.mjs",
    "verify": "npm test && npm run build && node scripts/verify.mjs && node --test scripts/legacy.test.mjs && node scripts/verify-media.mjs",
    "generate": "node scripts/generate.mjs",
    "measure": "node scripts/measure.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/starlight": "0.42.0",
    "@expressive-code/plugin-collapsible-sections": "0.44.2",
    "@expressive-code/plugin-line-numbers": "0.44.2",
    "@fontsource/ubuntu": "5.3.0",
    "@fontsource/ubuntu-mono": "5.3.0",
    "astro": "7.3.2",
    "rehype-mermaid": "3.0.0",
    "starlight-image-zoom": "0.16.0",
    "starlight-links-validator": "0.26.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "github-slugger": "2.0.0",
    "linkedom": "0.18.13",
    "playwright": "1.63.0",
    "remark-parse": "11.0.0",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.0"
  }
