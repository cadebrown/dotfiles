# Directories
# .claude is machine-local (settings.local.json, .cc-writes) EXCEPT rules/,
# which is checked in — path-scoped instruction files loaded by Claude Code.
.claude/*
!.claude/rules/
dotfiles-*/
docs/book/
site/node_modules/
site/dist/
site/.astro/
site/src/content/docs/
site/src/data/*.json
site/public/_redirects
site/public/llms.txt
site/public/evidence/
site/artifacts/
site/artifacts-*.log
old/
__pycache__/
# stray rustdoc JSON (rust-docs MCP / `rustdoc` defaults output here); real docs live in docs/
/doc/

# Secrets and credentials (should never be committed)
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
*.p12
*.pfx
terraform.tfvars
!terraform.tfvars.example

# IDE / OS
.vscode/settings.json
.DS_Store
*.swp

# Isolated outgoing-commit validation checkouts (removed after each push).
/.ci-validation/
